{
  "name": "dodreamga.com",
  "version": "1.0.0",
  "private": true,
  "description": "DoDream Baptist Church website — static, bilingual, deployed on Vercel.",
  "homepage": "https://dodreamga.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwoo6310/dodreamga.com.git"
  },
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --watch",
    "build": "npm run build:css",
    "dev": "npm run dev:css",
    "serve": "npx --yes http-server . -p 8080 --silent"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "engines": {
    "node": ">=18"
  }
}
